      ],
      "steps": [
        { "step": "gc retain", "action": "scheduler.tick", "args": { "job": "worktree-gc" } },
        { "step": "gc retain", "action": "runtime.expectCommand", "args": { "name": "dev", "type": "worktree.gc" }, "assert": [{ "path": "payload.policy", "equals": "retain_days" }, { "path": "payload.protectedTaskKeys", "length": 3 }], "extract": { "c1": "id" } },
        { "step": "gc retain", "action": "runtime.reply", "args": { "name": "dev", "type": "worktree.gc.result", "ref": "{{c1}}", "payload": { "dryRun": false, "removed": "{{fixture:gc.removed(done_days_gte=3)}}", "skippedRunning": 3, "freedBytes": 12000000000, "diskUsedRatioAfter": 0.66 } } },
        { "step": "gc retain", "action": "db.assert", "args": { "sql": "select count(*) as n from worktrees where state='removed'" }, "assert": [{ "path": "rows[0].n", "equals": 4 }] },
        { "step": "gc high", "action": "runtime.heartbeat", "args": { "name": "dev", "disk": { "usedRatio": 0.88, "freeBytes": 1 } } },
        { "step": "gc high", "action": "runtime.expectCommand", "args": { "name": "dev", "type": "worktree.gc" }, "assert": [{ "path": "payload.policy", "equals": "high_watermark" }], "extract": { "c2": "id" } },
