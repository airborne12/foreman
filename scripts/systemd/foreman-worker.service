[Unit]
Description=foreman worker (dev)
After=network-online.target

[Service]
# worker 的家目录写死：不用 %h / systemd 实例的 HOME。2026-09-29 开发机账号 home 从 /mnt/disk1 迁到 /mnt/disk14，
# 在跑的 systemd 实例仍是老 HOME、重登后又变成新 HOME，用 %h 会让配置、会话记录、claude 信任随之漂移。
# __HOME__ 由 scripts/deploy-worker.sh 渲染。
Environment=HOME=__HOME__
WorkingDirectory=__HOME__
EnvironmentFile=__HOME__/.foreman/env
ExecStart=/mnt/disk6/common/node-v24.14.1-linux-x64/bin/node __HOME__/.foreman/bin/foreman-worker.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
